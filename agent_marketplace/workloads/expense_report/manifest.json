              "amount": 42,
              "category": "  "
            }
          ],
          "expect": [
            {
              "merchant": "COFFEE cafe",
              "amount": 400,
              "category": "food"
            },
            {
              "merchant": "UBER",
              "amount": -12,
              "category": "transport"
            },
            {
              "merchant": "Book",
              "amount": 100,
              "category": "education"
            },
            {
              "merchant": "Unknown",
              "amount": 0,
              "category": "other"
            },
            {
              "merchant": "Restaurant",
              "amount": 42,
              "category": "food"
            }
          ]
        }
      ],
      "hidden_cases": [
        {
          "input": [],
          "expect": []
        }
      ],
      "fixture": "fixtures/categories.py",
      "simulated_first_attempt": "fixtures/categories_broken.py"
    },
    "summary": {
      "contract_id": "expense-summary-v1",
      "filename": "summary.py",
      "function": "summarize_expenses",
      "description": "Return total_cents, by_category and count from integer-cent amount fields. Reject boolean or non-int amounts. Default missing/blank category to other. Do not mutate input. No file/network access.",
      "spec": "Implement summarize_expenses(rows). Return a dict with total_cents (sum of integer amount values), by_category (category totals, missing/blank category defaults to other), and count. Reject non-integer and bool amounts with ValueError. Do not mutate input.",
      "depends_on": [
        "parser",
        "categories"
      ],
      "complexity": "medium",
      "output": {
        "type": "dict",
        "fields": {
          "total_cents": {
            "type": "int"
          },
          "count": {
            "type": "int"
          },
          "by_category": {
            "type": "dict",
            "values": {
              "type": "int"
            }
          }
        }
      },
      "public_cases": [
        {
          "input": [
            {
              "amount": 123,
              "category": "food"
            },
            {
              "amount": -23,
              "category": "food"
            },
            {
              "amount": 200
            },
            {
              "amount": 0,
              "category": ""
            }
          ],
          "expect": {
            "total_cents": 300,
            "by_category": {
              "food": 100,
              "other": 200
            },
            "count": 4
          }
        },
        {
          "input": [],
          "expect": {
            "total_cents": 0,
            "by_category": {},
            "count": 0
          }
        },
        {
          "input": [
            {
              "amount": true
            }
          ],
          "raises": true
        }
      ],
      "hidden_cases": [
        {
          "input": [
            {
              "amount": 1.2
            }
          ],
          "raises": true
        },
        {
          "input": [
            {
              "amount": "10"
            }
          ],
          "raises": true
        }
      ],
      "fixture": "fixtures/summary.py"
    }
  },
  "integration": {
    "input": "date,merchant,amount,category\n2026-10-01,Coffee House,4.50,\n2026-10-02,Train Ticket,12.00,\n2026-10-03,Book Shop,25.00,education\n2026-10-04,Cafe Refund,-1.25,\n",
    "input_filename": "public-expenses.csv",
    "result": {
      "$call": "summary",
      "arg": {
        "$call": "categories",
        "arg": {
          "$call": "parser",
          "arg": {
            "$input": true
          }
        }
      }
    },
    "expect": {
      "total_cents": 4025,
      "by_category": {
        "food": 325,
        "transport": 1200,
        "education": 2500
      },
      "count": 4
    }
  },
  "report": {
    "renderer": "expense-summary",
    "title": "Expense report"
  }
}
